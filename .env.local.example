# Backend API URL
# In production, NEXT_PUBLIC_API_URL MUST include '/api' at the end.
# Example: https://backend-gromar-contract.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Anthropic API key for the in-app chat widget
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Midtrans Client Key (dari dashboard Midtrans Sandbox)
# Settings -> Access Keys -> Client Key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
